# Application Settings
PROJECT_NAME="Car Showroom ERP API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite+aiosqlite:///./car_showroom.db"

# Security & JWT Configuration
JWT_SECRET_KEY="your-random-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cloudinary Integration Configuration (Optional)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
